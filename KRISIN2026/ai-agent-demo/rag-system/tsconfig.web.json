{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowJs": true,
        "types": ["node", "react", "react-dom"]
    },
    "include": ["web/react/**/*.tsx", "web/react/**/*.d.ts", "web/events.js"]
}
