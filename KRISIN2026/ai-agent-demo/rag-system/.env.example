# 与 ../agent-stack-web/.env.example 一致：仅服务端读取密钥。
# demo 执行真实 PG、切块和 LangGraph；向量为特征哈希，答案为原文摘录。
# live 使用真实 Embedding + LLM，不会在失败时偷偷切回 demo。
RAG_MODE=demo
PORT=3016
DATABASE_URL=postgresql://rag:rag_local_only@127.0.0.1:55432/rag_demo
RAG_TENANT_ID=demo-team

OPENAI_API_KEY=
AI_MODEL=gpt-5.6-terra
# 兼容 OpenAI Chat Completions 的 API 根地址；默认官方地址。
# OPENAI_BASE_URL=https://example.com/v1
# Embedding 可使用另一个兼容服务；不填则复用 OPENAI_*。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# 字符数不是 Token 数；这些数值仅用于演示，需评测后校准。
CHUNK_SIZE=600
CHUNK_OVERLAP=80
RECALL_K=20
CONTEXT_K=4
CONTEXT_CHAR_BUDGET=2400
MIN_VECTOR_SCORE=0.30
MIN_KEYWORD_SCORE=0.12

# 默认不上传轨迹。开启前确认知识库和查询允许传至 LangSmith。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-system-demo
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
