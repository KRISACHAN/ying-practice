{
    "name": "rag-system-demo",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "pnpm build:web && node --env-file-if-exists=.env.local --import tsx src/server.ts",
        "db:init": "node --env-file-if-exists=.env.local --import tsx src/cli.ts init",
        "seed": "node --env-file-if-exists=.env.local --import tsx src/cli.ts seed",
        "eval": "node --env-file-if-exists=.env.local --import tsx src/cli.ts eval",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
        "test": "node --import tsx --test test/unit.test.ts test/flow.test.ts",
        "test:integration": "node --env-file-if-exists=.env.local --import tsx --test test/integration.test.ts",
        "db:local": "node --env-file-if-exists=.env.local --import tsx src/local-db.ts",
        "db:stop": "node --env-file-if-exists=.env.local --import tsx src/local-db.ts stop",
        "build:web": "node scripts-build.mjs"
    },
    "dependencies": {
        "@ai-sdk/openai": "^4.0.78",
        "@hono/node-server": "^2.1.1",
        "@langchain/core": "^1.2.13",
        "@langchain/langgraph": "^1.4.18",
        "@langchain/textsplitters": "^1.0.2",
        "@xyflow/react": "^12.12.0",
        "ai": "^7.0.118",
        "hono": "^4.13.10",
        "pg": "^8.23.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/node": "^26.6.3",
        "@types/pg": "^8.23.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "esbuild": "^0.28.2",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "packageManager": "pnpm@11.8.0"
}
