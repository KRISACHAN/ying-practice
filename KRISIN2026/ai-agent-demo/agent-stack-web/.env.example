# 服务端模型配置。密钥只放在本地 .env.local，不要加 NEXT_PUBLIC_ 前缀。
OPENAI_API_KEY=
AI_MODEL=gpt-5.6-terra
# 如使用兼容 OpenAI API 的服务，可选填其 API 根地址。
# OPENAI_BASE_URL=https://example.com/v1

# 可选：启用 LangSmith 云端轨迹。不开启时，本地页面仍显示执行路径。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-stack-web-demo
# 非美国区域的账号按 LangSmith 文档设置区域 endpoint。
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
